# Never commit provider keys. Supply them through the process environment or
# the macOS Keychain launcher documented in README.md.
#
# This file is NOT read automatically: Settings uses env_file=None (settings.py) on purpose,
# so secrets never live in a dotenv file on disk -- only in macOS Keychain (see LOCAL_RUNBOOK.md).
# A literal `.env` file here has no effect. To override a NON-secret value such as
# LOCAL_CHAT_TIMEOUT_SECONDS, export it as a real process environment variable, or set it in
# scripts/run_api_with_keychain.py / the launchd plist's EnvironmentVariables, as WP-1 of
# CONVERSATIONAL_QUALITY_TECHNICAL_PLAN_V3.md does for LOCAL_CHAT_TIMEOUT_SECONDS.
APP_ENVIRONMENT=development
DEVELOPMENT_PURPOSE=private_poc
PROJECT_OWNER_RISK_OVERRIDE_ACK=0
SOURCE_POLICY_PATH=config/source_policies.development.json
DATABASE_URL=postgresql://127.0.0.1:55432/islamic_research_ai
GROQ_MODEL=openai/gpt-oss-20b
LOCAL_CHAT_ENABLED=1
LOCAL_CHAT_FORCE=0
LOCAL_CHAT_BASE_URL=http://127.0.0.1:18080/v1
LOCAL_CHAT_TIMEOUT_SECONDS=300
LOCAL_CHAT_HEALTH_TIMEOUT_SECONDS=5
LOCAL_CHAT_MAX_CONCURRENCY=1
LOCAL_CHAT_MAX_PROMPT_CHARACTERS=100000
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3
QURAN_EMBEDDING_VARIANT=base
QUL_TOPIC_ARM_ENABLED=0
QUL_TOPIC_ARM_LIMIT=20
CLOUDFLARE_ACCOUNT_ID=
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive
QF_TAFSIR_REGISTRY_PATH=config/tafsir_resources.json
QF_TIMEOUT_SECONDS=30
QF_CACHE_TTL_SECONDS=604800
# Recommended macOS Keychain services under account islamic-research-ai:
# quran-foundation-client-id and quran-foundation-client-secret
