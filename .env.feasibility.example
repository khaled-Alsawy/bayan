# Non-secret account identifiers and explicit safety assertions only.
# API tokens belong in macOS Keychain (see scripts/feasibility/README.md),
# or may be supplied as process environment variables for a single run.

CLOUDFLARE_ACCOUNT_ID=

# Probes abort unless these are set to the exact value "1" after the
# corresponding provider console has been visually verified.
GROQ_FREE_ONLY_CONFIRMED=0
GROQ_ZDR_CONFIRMED=0
CLOUDFLARE_FREE_ONLY_CONFIRMED=0
CLOUDFLARE_NO_GATEWAY_CREDITS_CONFIRMED=0

